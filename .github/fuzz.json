{
  "schema": 1,
  "language": "python",
  "setup": [
    [
      "python3",
      "-m",
      "venv",
      ".fuzz-venv"
    ],
    [
      ".fuzz-venv/bin/python",
      "-m",
      "pip",
      "install",
      "--require-hashes",
      "--only-binary=:all:",
      "-r",
      ".github/requirements-fuzz.txt"
    ]
  ],
  "targets": [
    {
      "name": "notification-frames",
      "engine": "atheris",
      "command": [
        ".fuzz-venv/bin/python",
        "fuzz/fuzz_notification_frames.py",
        "-max_len=4096"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/notification-frames",
      "instrumentation": [
        {
          "module": "notification_frame_cache",
          "functions": [
            "NotificationFrameCache.feed",
            "NotificationFrameCache.close"
          ]
        }
      ]
    }
  ],
  "preflight-paths": [
    ".github/requirements-fuzz.in",
    "config",
    "fuzz",
    "pyproject.toml",
    "requirements.txt"
  ]
}

# Copy into a LOCAL secrets.yaml; never commit real values.
igw_cast_authorization: 'Bearer REPLACE_WITH_EXISTING_LOCAL_CAST_CREDENTIAL'
home_latitude: 0.0
home_longitude: 0.0
# Internal origin: the public control templates do not expose /v1/catalogue.
epg_voice_gateway_play_url: http://gateway.home.arpa:8080/v1/play
epg_voice_gateway_catalogue_url: http://gateway.home.arpa:8080/v1/catalogue
epg_voice_gateway_authorization: Bearer REPLACE_LOCALLY
epg_voice_player_entity: media_player.example_display
epg_voice_news_channel_id: REPLACE_WITH_VERIFIED_CATALOGUE_CHANNEL_ID
epg_voice_ren_channel_id: REPLACE_WITH_VERIFIED_CATALOGUE_CHANNEL_ID
epg_voice_google_project_id: REPLACE_WITH_GOOGLE_PROJECT_ID
epg_voice_google_agent_user_id: REPLACE_WITH_LINKED_HA_USER_ID
# Copy the private JSON file separately; never place it in Git.
epg_voice_google_service_account: !include home-media-service-account.json
igw_energy_authorization: REPLACE_LOCALLY
igw_energy_url: REPLACE_LOCALLY
recorder_db_url: REPLACE_LOCALLY
reddit_client_id: REPLACE_LOCALLY
reddit_client_secret: REPLACE_LOCALLY
reddit_password: REPLACE_LOCALLY
reddit_username: REPLACE_LOCALLY
# Learned Dooya identities; integer placeholders only. See docs/living-curtains-rf.md.
living_main_curtain_rf_remote_id: 0
living_main_curtain_rf_channel: 0
living_sheer_curtain_rf_remote_id: 0
living_sheer_curtain_rf_channel: 0

# Full Authorization header for the private Core updater; generated/deployed locally.
ha_core_updater_authorization: "Bearer REPLACE_LOCALLY"

# Full Authorization header for the existing OTT controller (RM433 -> d1).
ott_control_authorization: 'Bearer REPLACE_WITH_EXISTING_OTT_ADMIN_TOKEN'

# Deployment URLs are kept local; use the existing origins, without a trailing slash.
home_assistant_external_url: https://ha.example.invalid
ott_control_devices_url: https://control.example.invalid/ott-control/api/devices
# The query device_id must match the existing d1 identity in ott_d1_remote.yaml.
ott_control_d1_input_url: https://control.example.invalid/ott-control/api/requests?device_id=dev_c0b414dd92b2b5a36fffde703a6968f5

    "living_room_tv_picture_energy_saving": {
      "sequence": [
        {
          "service": "webostv.command",
          "data": {
            "entity_id": "media_player.living_room_tv_77",
            "command": "system.notifications/createAlert",
            "payload": {
              "title": "Energy saving",
              "message": "{{ energy_saving }}",
              "modal": false,
              "buttons": [
                {
                  "label": "ok",
                  "focus": true,
                  "buttonType": "ok",
                  "onClick": "luna://com.webos.settingsservice/setSystemSettings",
                  "params": {
                    "category": "picture",
                    "settings": {
                      "energySaving": "{{ energy_saving }}",
                      "energySavingModified": "true"
                    }
                  }
                }
              ],
              "type": "confirm",
              "isSysReq": true
            }
          }
        }
      ]
    },

    "play_kodi_channel": {
      "alias": "Play Kodi Channel",
      "sequence": [
        {
          "service": "media_player.play_media",
          "target": {
            "entity_id": "media_player.192_168_160_1"
          },
          "data": {
            "media_content_type": "CHANNEL",
            "media_content_id": "{% set channelid = state_attr('input_select.kodi_channel_selector', 'state') %} {% set channels = (states('sensor.kodi_channels') | from_json) %} {% for channel in channels %}\n  {% if channel.label == channelid %}\n    {{ channel.channelid }}\n  {% endif %}\n{% endfor %}\n"
          }
        }
      ]
    },
    "your_kodi_script": {

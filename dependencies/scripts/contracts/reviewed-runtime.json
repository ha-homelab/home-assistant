{
  "format_version": 1,
  "change": "2026-09-22 runtime resilience audit; 2026-09-23 owner retired the LocalTuya TV power switch; 2026-09-23 validated camera snapshot capture; 2026-09-24 confirmed entity references; 2026-09-25 owner-retired lights; 2026-10-02 owner moved the Home Assistant public origin from h2 to h7; 2026-10-07 owner renamed five ZHA garage bulbs and included the fifth in household shutdown; 2026-10-10 Bath2 migrated from the old Tuya light to the ESPHome relay; 2026-10-10 owner retired the former Studio wall-lamp role after moving the controller to Dining Arc lamp; remove only its old household shutdown target; 2026-10-10 Kitchen ESPHome migration: retain both lighting targets using their switch entities and generic homeassistant.turn_off for the mixed list; preserve the remaining sequence. 2026-10-10: add the relocated Matter Bedroom Lamp to household shutdown; preserve every other target and the iNew shutdown helper. 2026-10-10: the owner repurposed the second KMC audio output as Living lamp; retain it in household shutdown using switch.living_lamp, leaving all other targets and failure handling unchanged. 2026-10-10: remove only the first KMC former Fireplace and Stage LED targets from household shutdown after reassignment to water equipment power and Laundry; do not substitute the new power controls. 2026-10-11: owner retired Sockets behind fireplace two; remove its three obsolete shutdown targets, preserving all other targets, error handling and host shutdown. Public source migration: tv_pic uses the configured input_text.base_url; historical URL samples use example.invalid. 2026-10-20: the legacy backdoor motion pulse checks Porch Sticky immediately before each light command, including delayed dimming and final shutdown; notification delivery remains unchanged.",
  "scripts": {
    "tv_pic2": {
      "alias": "Living room TV: notify with front-camera snapshot",
      "description": "Send the front-camera message and snapshot icon through the registered living-room LG TV notifier.",
      "icon": "mdi:cctv",
      "mode": "single",
      "sequence": [
        {
          "action": "script.notify_optional",
          "data": {
            "notify_service": "notify.lg_webos_tv_oled77c5pua_dusqljr",
            "also_chrome": true,
            "chrome_image": "/local/front_camera_alert.jpg?{{ as_timestamp(now()) }}",
            "notify_data": {
              "data": {
                "icon": "/config/www/front_camera_alert.jpg"
              },
              "message": "Someone at the Front Camera"
            }
          }
        }
      ]
    },
    "turn_off_living_room": {
      "alias": "Household: turn off lights and media power",
      "description": "Turn off the original multi-room light and switch lists, then invoke the iNew host shutdown helper.",
      "icon": "mdi:home-lightbulb-outline",
      "mode": "single",
      "sequence": [
        {
          "service": "homeassistant.turn_off",
          "entity_id": [
            "light.bedroom_light_dimmer_l",
            "light.bedroom_lamp",
            "light.hall_1_m",
            "light.hall_2_m",
            "switch.tea_table",
            "switch.led_under_cabinet",
            "light.kitchen_lamp",
            "light.fireplace_led_ll",
            "light.bathroom_mirror_light",
            "light.bath_2",
            "light.dining_lights_dimmer_l",
            "light.balcony",
            "light.porch_one",
            "light.porch_two",
            "light.garage_one",
            "light.garage_two",
            "light.garage_three",
            "light.backdoor_porch",
            "light.living_wall_dimmer_l",
            "light.garage_bulb_one",
            "light.garage_bulb_two",
            "light.garage_bulb_three",
            "light.garage_bulb_four",
            "light.garage_bulb_five",
            "light.bedroom_five"
          ],
          "continue_on_error": true
        },
        {
          "service": "switch.turn_off",
          "entity_id": [
            "switch.fireplace_led_ll",
            "switch.tv_backlight_l",
            "switch.mishka_bedroom_desk_lamp_l",
            "switch.dining_wall_lights_l",
            "switch.living_room_light_l",
            "switch.living_lamp",
            "switch.audiosystem_l"
          ],
          "continue_on_error": true
        },
        {
          "service": "shell_command.shutdown_inew"
        }
      ]
    },
    "notify_mqtt": {
      "alias": "Notifications: publish retained MQTT message",
      "description": "Publish a correctly escaped JSON message to the existing retained MQTT notification topic; queue simultaneous calls.",
      "icon": "mdi:message-text",
      "fields": {
        "message": {
          "name": "Message",
          "description": "Message text forwarded using the existing notification template.",
          "required": true,
          "selector": {
            "text": {
              "multiline": true
            }
          }
        }
      },
      "mode": "queued",
      "sequence": [
        {
          "service": "mqtt.publish",
          "data_template": {
            "payload": "{{ {\"title\": \"Info\", \"message\": message | string} | to_json }}",
            "topic": "living_room/notifications",
            "retain": true
          }
        }
      ],
      "max": 100
    },
    "garagemotion": {
      "alias": "Garage camera: send motion notifications",
      "description": "Take a garage-camera snapshot and notify desktops; send browser notifications between 09:05 and 23:00.",
      "icon": "mdi:cctv",
      "mode": "single",
      "sequence": [
        {
          "action": "script.capture_camera_alert",
          "data": {
            "camera_key": "garage"
          }
        },
        {
          "action": "script.notify_optional",
          "data": {
            "notify_service": "notify.roomba",
            "notify_data": {
              "title": "Garage",
              "message": "Motion detected",
              "data": {
                "displaytime": 20000,
                "icon": "warning"
              }
            }
          }
        },
        {
          "action": "script.notify_optional",
          "data": {
            "notify_service": "notify.imac21",
            "notify_data": {
              "title": "Garage",
              "message": "Motion detected",
              "data": {
                "displaytime": 20000,
                "icon": "warning"
              }
            }
          }
        },
        {
          "condition": "time",
          "after": "09:05:00",
          "before": "23:00:00"
        },
        {
          "action": "script.notify_optional",
          "data": {
            "notify_service": "html5.send_message",
            "notify_data": {
              "message": "garage Motion {{ as_timestamp(now()) | timestamp_custom('%H:%M', true) }}",
              "entity_id": "notify.chrome",
              "icon": "/local/garage_camera_alert.jpg?{{ as_timestamp(now()) }}",
              "image": "/local/garage_camera_alert.jpg?{{ as_timestamp(now()) }}",
              "data": {
                "url": "/local/garage_camera_alert.jpg?{{ as_timestamp(now()) }}"
              }
            }
          }
        }
      ]
    },
    "notifymax": {
      "alias": "Notifications: send desktop and persistent message",
      "description": "Send a timestamped message to the Roomba, iMac and Chrome targets and create a persistent Home Assistant notification.",
      "icon": "mdi:message-alert",
      "fields": {
        "message": {
          "name": "Message",
          "description": "Message text forwarded using the existing notification template.",
          "required": true,
          "selector": {
            "text": {
              "multiline": true
            }
          }
        }
      },
      "mode": "single",
      "sequence": [
        {
          "action": "script.notify_optional",
          "data": {
            "notify_service": "notify.roomba",
            "also_chrome": true,
            "notify_data": {
              "title": "{{ message }}",
              "message": "{{ message }} {{ as_timestamp(now()) | timestamp_custom('%H:%M', true) }}",
              "data": {
                "displaytime": 20000,
                "icon": "warning"
              }
            }
          }
        },
        {
          "action": "script.notify_optional",
          "data": {
            "notify_service": "notify.imac21",
            "notify_data": {
              "title": "{{ message }}",
              "message": "{{ message }} {{ as_timestamp(now()) | timestamp_custom('%H:%M', true) }}",
              "data": {
                "displaytime": 20000,
                "icon": "warning"
              }
            }
          }
        },
        {
          "service": "persistent_notification.create",
          "data_template": {
            "title": "{{ message }}",
            "message": "{{ message }} {{ as_timestamp(now()) | timestamp_custom('%H:%M', true) }}"
          }
        }
      ]
    },
    "backdoormotion": {
      "alias": "Backdoor: notify and pulse porch light",
      "description": "Take a backdoor snapshot and notify desktops; between 20:30 and 22:00, also repeat the browser notification and run the existing porch-light fade.",
      "icon": "mdi:motion-sensor",
      "mode": "single",
      "sequence": [
        {
          "action": "script.capture_camera_alert",
          "data": {
            "camera_key": "backdoor"
          }
        },
        {
          "action": "script.notify_optional",
          "data": {
            "notify_service": "html5.send_message",
            "notify_data": {
              "message": "backdoor Motion {{ as_timestamp(now()) | timestamp_custom('%H:%M', true) }}",
              "entity_id": "notify.chrome",
              "icon": "/local/backdoor_camera_alert.jpg?{{ as_timestamp(now()) }}",
              "image": "/local/backdoor_camera_alert.jpg?{{ as_timestamp(now()) }}",
              "data": {
                "url": "/local/backdoor_camera_alert.jpg?{{ as_timestamp(now()) }}"
              }
            }
          }
        },
        {
          "action": "script.notify_optional",
          "data": {
            "notify_service": "notify.roomba",
            "notify_data": {
              "title": "Backdoor Camera",
              "message": "Motion detected",
              "data": {
                "displaytime": 20000,
                "icon": "warning"
              }
            }
          }
        },
        {
          "action": "script.notify_optional",
          "data": {
            "notify_service": "notify.imac21",
            "notify_data": {
              "title": "Backdoor Camera",
              "message": "Motion detected",
              "data": {
                "displaytime": 20000,
                "icon": "warning"
              }
            }
          }
        },
        {
          "condition": "time",
          "after": "20:30:00",
          "before": "22:00:00"
        },
        {
          "action": "script.notify_optional",
          "data": {
            "notify_service": "html5.send_message",
            "notify_data": {
              "message": "Backdoor Motion",
              "entity_id": "notify.chrome",
              "data": {
                "url": "/"
              }
            }
          }
        },
        {
          "condition": "state",
          "entity_id": "input_boolean.porch_sticky",
          "state": "off"
        },
        {
          "service": "light.turn_on",
          "entity_id": "light.backdoor_porch",
          "data": {
            "brightness": 117
          }
        },
        {
          "delay": "00:00:10"
        },
        {
          "repeat": {
            "for_each": [
              90,
              78,
              66,
              54,
              42
            ],
            "sequence": [
              {
                "condition": "state",
                "entity_id": "input_boolean.porch_sticky",
                "state": "off"
              },
              {
                "action": "light.turn_on",
                "target": {
                  "entity_id": "light.backdoor_porch"
                },
                "data": {
                  "brightness": "{{ repeat.item }}"
                }
              },
              {
                "delay": "00:00:01"
              }
            ]
          }
        },
        {
          "condition": "state",
          "entity_id": "input_boolean.porch_sticky",
          "state": "off"
        },
        {
          "service": "light.turn_on",
          "entity_id": "light.backdoor_porch",
          "data": {
            "brightness": 30
          }
        },
        {
          "delay": "00:00:05"
        },
        {
          "condition": "state",
          "entity_id": "input_boolean.porch_sticky",
          "state": "off"
        },
        {
          "service": "light.turn_off",
          "entity_id": "light.backdoor_porch"
        }
      ]
    },

    "mediaoff": {
      "alias": "Media: turn off household players",
      "description": "Turn off the eight retained household media players in sequence, continuing when an individual player fails.",
      "icon": "mdi:speaker-off",
      "mode": "single",
      "sequence": [
        {
          "repeat": {
            "for_each": [
              "media_player.bathroom_echo_dot",
              "media_player.living_room_echo",
              "media_player.bathroom_speaker",
              "media_player.kitchen_speaker_2",
              "media_player.family_room_speaker_2",
              "media_player.dinning_room_google_mini",
              "media_player.mishka_bedroom_google_mini",
              "media_player.living_room_google_home"
            ],
            "sequence": [
              {
                "action": "media_player.turn_off",
                "target": {
                  "entity_id": "{{ repeat.item }}"
                },
                "continue_on_error": true
              }
            ]
          }
        }
      ]
    },
    "volume_down": {
      "alias": "Media: set household volume presets",
      "description": "Set the retained Echo volume preset to 20 percent.",
      "icon": "mdi:volume-medium",
      "mode": "single",
      "sequence": [
        {
          "service": "media_player.volume_set",
          "data": {
            "entity_id": "media_player.vitaly_s_echo",
            "volume_level": 0.2
          }
        }
      ]
    },
    "tv_type2": {
      "alias": "Living room TV: insert legacy test text",
      "description": "Insert the literal text 123 through the existing webOS input-method command with replace set to zero.",
      "icon": "mdi:keyboard",
      "mode": "single",
      "sequence": [
        {
          "service": "webostv.command",
          "target": {
            "entity_id": "media_player.living_room_tv_77"
          },
          "data": {
            "command": "com.webos.service.ime/insertText",
            "payload": {
              "text": "123",
              "replace": 0
            }
          }
        }
      ]
    },
